# Copy to .env.local for local dev, or run `vercel env pull .env.local`.
# Validated by src/lib/env.ts. Never commit real values.

# Postgres via Supabase transaction pooler (:6543). Required.
# Local: docker run -d --name ovl-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
# then DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=
# Connections per function instance (default 5). Set 1 for `pnpm db:local`
# (PGlite multiplexes one session and garbles concurrent queries).
DATABASE_POOL_MAX=
# Direct/session connection for migrations and backups (CI/scripts only)
DATABASE_URL_DIRECT=

# Supabase Storage signed uploads (server only; S5-05 uploads answer
# STORAGE_UNAVAILABLE without them). Local E2E: http://localhost:54330 and
# e2e-service-key (tests/e2e/fake-storage.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the `media` bucket, e.g.
# https://<project>.supabase.co/storage/v1/object/public/media (inlined at build;
# also added to the CSP img-src/connect-src)
NEXT_PUBLIC_MEDIA_BASE_URL=

# Public origin for canonical links, sitemap and OG images (S8-05). Optional:
# defaults to the Vercel production host, else http://localhost:3000.
SITE_URL=

# 32+ random bytes, used when hashing session tokens. Required.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=

# Gemini (S7-01). Separate keys for prod and staging. Without a key every AI
# feature answers AI_UNAVAILABLE. A model may list fallbacks, comma-separated
# (each free-tier model has its own quota and load; put a reliably available
# one first, docs/09 §2), e.g.
# GEMINI_MODEL_IMPORT=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=
GEMINI_MODEL_IMPORT=
# Hard ceiling on Gemini calls per day over the admin setting (0 = none; staging: 20)
AI_DAILY_BUDGET=20

# Vercel cron auth (required from S9-05)
CRON_SECRET=

# Optional preview-only operation/cache-miss timings; counts and duration only.
PERFORMANCE_DIAGNOSTICS=0

# Optional Sentry project DSN (public key). Never set SENTRY_AUTH_TOKEN here.
# Errors are allowlisted; requests, users, breadcrumbs and messages are removed.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Scripts only: first admin created by `pnpm seed`. If the password is empty,
# the dev profile generates one and prints it once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Scripts only: v1 database for scripts/v1-inventory.ts and export-v1-fixtures.ts
V1_DATABASE_URL=
