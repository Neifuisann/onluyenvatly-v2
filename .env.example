# Copy to .env.local for local dev, or run `vercel env pull .env.local`.
# Validated by src/lib/env.ts. Never commit real values.

# Postgres via Supabase transaction pooler (:6543). Local: Docker Postgres. (required from S1-03)
DATABASE_URL=
# Direct/session connection for migrations and backups (CI/scripts only)
DATABASE_URL_DIRECT=

# Supabase Storage signed uploads (server only, required from S5-05)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the `media` bucket
NEXT_PUBLIC_MEDIA_BASE_URL=

# 32+ random bytes, used when hashing session tokens (required from S1-04)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=

# Gemini (required from S7-01). Separate keys for prod and staging.
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=
GEMINI_MODEL_IMPORT=
# Global cap on Gemini calls per day (staging: 20)
AI_DAILY_BUDGET=20

# Vercel cron auth (required from S9-05)
CRON_SECRET=

# Scripts only: v1 database for scripts/v1-inventory.ts and export-v1-fixtures.ts
V1_DATABASE_URL=
