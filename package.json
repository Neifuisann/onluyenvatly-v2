{
  "name": "onluyenvatly-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "v1:inventory": "node --env-file-if-exists=.env.local scripts/v1-inventory.ts",
    "v1:fixtures": "node --env-file-if-exists=.env.local scripts/export-v1-fixtures.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "load:fixture": "node --env-file-if-exists=.env.local scripts/load-fixture.ts",
    "db:local": "pglite-server --db=.pglite --port=54329 --max-connections=50 --extensions=pg_trgm,unaccent",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "migrate:legacy": "node --env-file-if-exists=.env.local scripts/migrate-legacy.ts"
  },
  "dependencies": {
