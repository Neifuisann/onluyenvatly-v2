    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
